# Copy to .env and edit. .env is the ONLY place secrets go (never the image).
# Then: docker compose up -d --build

# ---- access ------------------------------------------------------------------
# One shared password for the web chat AND the desktop view. Required.
# At least 12 characters when BIND_ADDRESS is not 127.0.0.1.
ACCESS_PASSWORD=change-me-to-a-long-random-password

# Where the one port is published on the host.
#   Local test:   BIND_ADDRESS=127.0.0.1  PORT=8080  PUBLIC_HOSTNAME=   (plain HTTP)
#   Public server: BIND_ADDRESS=0.0.0.0   PORT=443   PUBLIC_HOSTNAME=bot.example.com
#     (DNS A record -> server; Caddy gets a Let's Encrypt certificate itself,
#      using the TLS-ALPN challenge on port 443 only. Plain HTTP on a public
#      address is refused unless ALLOW_PUBLIC_HTTP=yes.)
BIND_ADDRESS=127.0.0.1
PORT=8080
PUBLIC_HOSTNAME=
ACME_EMAIL=

# ---- model: any OpenAI-compatible endpoint -----------------------------------
# Option A (default here): local Ollama on this host, free. gemma3:4b and
# deepseek-r1:8b do NOT support tool calls in Ollama, so tools are switched off
# for them: the bot chats but cannot use its computer with this brain.
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=
MODEL_NAME=gemma3:4b
MODEL_SUPPORTS_TOOLS=false
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_TOKENS=4096

# Option B: Chutes (Bittensor SN64), OpenAI-compatible. [PAID] per token.
# Key: https://chutes.ai/app/settings/api-keys . Model ids: GET https://llm.chutes.ai/v1/models
# ("-TEE" models run in Intel TDX + NVIDIA confidential GPUs; see SECURITY-NOTES.md).
# zai-org/GLM-5.2-TEE is OpenClaw's own default for Chutes and supports tool calls.
# MODEL_BASE_URL=https://llm.chutes.ai/v1
# MODEL_API_KEY=your-chutes-api-key
# MODEL_NAME=zai-org/GLM-5.2-TEE
# MODEL_SUPPORTS_TOOLS=true
# MODEL_CONTEXT_WINDOW=131072
# MODEL_MAX_TOKENS=8192

# Option C: any other OpenAI-compatible server (vLLM, LiteLLM, OpenRouter, ...)
# MODEL_BASE_URL=https://example-provider/v1
# MODEL_API_KEY=...
# MODEL_NAME=provider-model-id
# MODEL_SUPPORTS_TOOLS=true

# ---- Telegram (optional) -----------------------------------------------------
# Paste a token from @BotFather and restart (docker compose up -d). Long polling,
# outbound only. Without TELEGRAM_ALLOWED_USER_IDS, the first DM gets a pairing
# code: approve it in the web UI (Settings > Channels > DM access requests).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ---- behaviour / sizing --------------------------------------------------------
# full = agent runs shell commands without asking (default, demo);
# ask  = allowlist + ask the owner for anything else (approvals in the web UI).
EXEC_MODE=full
BOT_NAME=fugal-bot
BOT_MEM_LIMIT=2560m
BOT_CPUS=2.0
DESKTOP_GEOMETRY=1280x800
TZ=UTC
