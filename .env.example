# Copy to .env and edit. .env is the ONLY place secrets go (never the image).
# Then: docker compose up -d --build

# ---- access ------------------------------------------------------------------
# One shared password for the web chat AND the desktop view. Required.
# At least 12 characters when BIND_ADDRESS is not 127.0.0.1.
ACCESS_PASSWORD=change-me-to-a-long-random-password

# Where the one port is published on the host.
#   Local test:   BIND_ADDRESS=127.0.0.1  PORT=8080  PUBLIC_HOSTNAME=   (plain HTTP)
#   Public server: BIND_ADDRESS=0.0.0.0   PORT=443   PUBLIC_HOSTNAME=bot.example.com
#     (DNS A record -> server; Caddy gets a Let's Encrypt certificate itself,
#      using the TLS-ALPN challenge on port 443 only. Plain HTTP on a public
#      address is refused unless ALLOW_PUBLIC_HTTP=yes.)
BIND_ADDRESS=127.0.0.1
PORT=8080
PUBLIC_HOSTNAME=
ACME_EMAIL=

# ---- model: any OpenAI-compatible endpoint -----------------------------------
# MODEL_BASE_URL and MODEL_API_KEY are given ONLY to the "modelproxy" service.
# The agent container gets that service's internal address and a placeholder
# key, so the agent (and anything that hijacks it) cannot read the real key.
#
# Option A (default here): a local Ollama server on the same machine, free.
# Many small models (e.g. gemma3:4b, deepseek-r1:8b) do NOT support tool calls
# in Ollama; with MODEL_SUPPORTS_TOOLS=false the bot chats but cannot use its
# computer. Ollama's default context is small, so long prompts get truncated.
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=
MODEL_NAME=gemma3:4b
MODEL_SUPPORTS_TOOLS=false
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_TOKENS=4096

# Option B: Chutes (Bittensor subnet 64), OpenAI-compatible. PAID per token.
# Key: https://chutes.ai/app/settings/api-keys   Models: https://llm.chutes.ai/v1/models
# (pick one whose supported_features include "tools"; "-TEE" models are
# advertised as running in confidential VMs; see SECURITY-NOTES.md).
# MODEL_BASE_URL=https://llm.chutes.ai/v1
# MODEL_API_KEY=your-chutes-api-key
# MODEL_NAME=moonshotai/Kimi-K2.6-TEE
# MODEL_SUPPORTS_TOOLS=true
# MODEL_CONTEXT_WINDOW=262144
# MODEL_MAX_TOKENS=8192

# Option C: any other OpenAI-compatible endpoint: change the base URL, key and
# model id. For example Engy (https://api.engy.ai/v1), gm
# (https://api.saygm.com/v1), or your own vLLM / LiteLLM / OpenRouter.
# MODEL_BASE_URL=https://example-provider/v1
# MODEL_API_KEY=...
# MODEL_NAME=provider-model-id
# MODEL_SUPPORTS_TOOLS=true

# ---- inference budget (optional; enforced by the modelproxy service) -----------
# The model proxy counts the prompt and completion tokens of every model call
# (per UTC day and in total; the counters are kept in the data volume). Hard
# caps: once one is reached, further model calls are refused and the bot says
# that its allowance is used up. Empty or 0 = no limit. A cap is checked before each
# call, so the last call can overshoot it by its own size.
BUDGET_TOKENS_PER_DAY=
BUDGET_TOKENS_TOTAL=
# Caps in US dollars need prices: USD per million input and output tokens, per
# model id, as JSON on one line; "*" is the price for any model not listed.
#   BUDGET_PRICES={"moonshotai/Kimi-K2.6-TEE":[0.6,2.5],"*":[1,3]}
BUDGET_PRICES=
BUDGET_USD_PER_DAY=
BUDGET_USD_TOTAL=
# At most this many model calls per minute (an agent turn makes several).
BUDGET_REQUESTS_PER_MINUTE=
# How a call is answered once a cap is reached: 400 (default), 429, 402 or
# 200. Leave it empty unless you have read docs/MODELPROXY.md: 429 and 402
# make OpenClaw switch the model off for ten minutes.
MODELPROXY_EXHAUSTED_REPLY=

# ---- Telegram (optional) -----------------------------------------------------
# Paste a token from @BotFather and restart (docker compose up -d). Long polling,
# outbound only. Without TELEGRAM_ALLOWED_USER_IDS, the first DM gets a pairing
# code: approve it in the web UI (Settings > Channels > DM access requests).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ---- behaviour / sizing --------------------------------------------------------
# full = agent runs shell commands without asking (default, demo);
# ask  = allowlist + ask the owner for anything else (approvals in the web UI).
EXEC_MODE=full
BOT_NAME=fugal-bot
BOT_MEM_LIMIT=2560m
BOT_CPUS=2.0
DESKTOP_GEOMETRY=1280x800
TZ=UTC
# Internal Docker networks (first three octets of two /28 ranges). Change only
# if they clash with another network on the host, or to run two bots side by side.
FRONT_NET=10.213.57
TUNNEL_NET=10.213.58

# ---- login page (optional; shown only when set) --------------------------------
# e.g. HOST_LABEL=Cathedral confidential sandbox (Bittensor subnet 94)
HOST_LABEL=
# e.g. MODEL_LABEL=Kimi K2.6 on Chutes (TEE). Nothing about the model is shown unless set.
MODEL_LABEL=
# e.g. a link to the source code
REPO_URL=

# ==== hosted mode (only for a bot run FOR its owner by a site; leave empty otherwise) ====
# For a site that runs many bots, one per owner, each in its own room, and
# shows them in a frame on its own page. Used with
#   COMPOSE_FILE=compose.yaml:compose.cathedral.yaml:compose.hosted.yaml
#   COMPOSE_PROFILES=hosted
# (docs/CATHEDRAL.md, "Hosted mode"). A bot you run for yourself needs none of this.
#
# GATE_SSO=on replaces the password login by a one-time token that the site
# posts into the frame; the password form is then switched off, and
# ACCESS_PASSWORD (32+ random characters, never typed by anyone) is only the
# secret the tokens are signed with. SESSION_HOURS is how long a sign-in lasts.
GATE_SSO=
# This bot's id ("b" and 10 characters of a-z, 2-7); tokens for other bots are refused.
GATE_BOT_ID=
# The page that shows the bot. A browser that opens the bot directly, without
# a session, is sent there.
GATE_LOGIN_URL=
# The one origin that may show the bot in a frame and post the token. Empty =
# the origin of GATE_LOGIN_URL.
GATE_PARENT_ORIGIN=
# Token of the Cloudflare named tunnel that gives this bot its hostname. Given
# only to the tunnel service, as an environment variable.
TUNNEL_TOKEN=
# An age PUBLIC key ("age1..."); backups are encrypted to it. The private key
# stays with the site. Given only to the backup one-shot.
BACKUP_AGE_RECIPIENT=
# SESSION_HOURS=24

# ---- published images (optional) -------------------------------------------------
# Point these at published, digest-pinned images to skip building. Then:
#   docker compose pull bot modelproxy gate proxy && docker compose up -d --no-build
# (add --profile tunnel to both for the tunnel). PROXY_IMAGE must be the
# no-file-capability build (proxy/Dockerfile.nocap) to work in Cathedral rooms.
BOT_IMAGE=
MODELPROXY_IMAGE=
GATE_IMAGE=
PROXY_IMAGE=
