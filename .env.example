# Copy to .env and edit. .env is the ONLY place secrets go (never the image).
# Then: docker compose up -d --build

# ---- access ------------------------------------------------------------------
# One shared password for the web chat AND the desktop view. Required.
# At least 12 characters when BIND_ADDRESS is not 127.0.0.1.
ACCESS_PASSWORD=change-me-to-a-long-random-password

# Where the one port is published on the host.
#   Local test:   BIND_ADDRESS=127.0.0.1  PORT=8080  PUBLIC_HOSTNAME=   (plain HTTP)
#   Public server: BIND_ADDRESS=0.0.0.0   PORT=443   PUBLIC_HOSTNAME=bot.example.com
#     (DNS A record -> server; Caddy gets a Let's Encrypt certificate itself,
#      using the TLS-ALPN challenge on port 443 only. Plain HTTP on a public
#      address is refused unless ALLOW_PUBLIC_HTTP=yes.)
BIND_ADDRESS=127.0.0.1
PORT=8080
PUBLIC_HOSTNAME=
ACME_EMAIL=
# ALLOW_PUBLIC_HTTP=yes        # plain HTTP on a public address; only behind your own TLS
# How long a login lasts, in hours.
# SESSION_HOURS=168

# ---- model: any OpenAI-compatible endpoint -----------------------------------
# MODEL_BASE_URL and MODEL_API_KEY are given ONLY to the "modelproxy" service.
# The agent container gets that service's internal address and a placeholder
# key, so the agent (and anything that hijacks it) cannot read the real key.
#
# Option A (default here): a local Ollama server on the same machine, free.
# Many small models (e.g. gemma3:4b, deepseek-r1:8b) do NOT support tool calls
# in Ollama; with MODEL_SUPPORTS_TOOLS=false the bot chats but cannot use its
# computer. Ollama's default context is small, so long prompts get truncated.
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=
MODEL_NAME=gemma3:4b
MODEL_SUPPORTS_TOOLS=false
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_TOKENS=4096

# Option B: Chutes (Bittensor subnet 64), OpenAI-compatible. PAID per token.
# Key: https://chutes.ai/app/settings/api-keys   Models: https://llm.chutes.ai/v1/models
# (pick one whose supported_features include "tools"; "-TEE" models are
# advertised as running in confidential VMs; see SECURITY-NOTES.md).
# Values tested on 2026-11-22 with direct calls to Chutes (not yet through the
# whole bot; README, "Model settings"):
#   default       deepseek-ai/DeepSeek-V4-Flash-0731-TEE   text only; by far the fastest;
#                                                          21 of 22 tool calls right
#   if it fails   zai-org/GLM-5.1-TEE                      text only; no tool failure seen;
#                                                          about twice the price
#   with images   moonshotai/Kimi-K2.6-TEE                 MODEL_INPUT=text,image, and turn
#                                                          its thinking off (MODEL_EXTRA_BODY
#                                                          below) or it is slow
# MODEL_BASE_URL=https://llm.chutes.ai/v1
# MODEL_API_KEY=your-chutes-api-key
# MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash-0731-TEE
# MODEL_SUPPORTS_TOOLS=true
# MODEL_INPUT=text
# MODEL_CONTEXT_WINDOW=64000     # the model allows 1,048,576; a smaller window caps what one call can cost
# MODEL_MAX_TOKENS=4096

# Option C: any other OpenAI-compatible endpoint: change the base URL, key and
# model id. For example Engy (https://api.engy.ai/v1), gm
# (https://api.saygm.com/v1), or your own vLLM / LiteLLM / OpenRouter.
# MODEL_BASE_URL=https://example-provider/v1
# MODEL_API_KEY=...
# MODEL_NAME=provider-model-id
# MODEL_SUPPORTS_TOOLS=true

# What the model accepts: text (the default), or text,image for a model that
# takes image parts. A text-only model answers HTTP 400 to a request with an
# image in it, so only add image when the model's own listing says so.
MODEL_INPUT=text
# true = tell OpenClaw the model can "think"; it then sends a reasoning-effort
# field with each request. Leave false for the Chutes models above (two of
# them start thinking when they receive that field).
MODEL_REASONING=false
# Extra JSON fields put into every model request, on one line. The main use is
# to turn a model's "thinking" off where it is on by default and slow (on
# Chutes: Kimi-K2.6, GLM-5.1, Qwen; DeepSeek-V4-Flash does not need it):
#   MODEL_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
MODEL_EXTRA_BODY=
# off = no model calls without a message from you: switches off OpenClaw's
# nightly memory consolidation ("dreaming"), which otherwise spends tokens
# while you are away. Schedules you set up yourself still run.
BACKGROUND_MODEL_USE=
# Tools left out of the list sent to the model with every request. Empty = the
# ones that cannot work in this package (paired devices, voice, publishing to
# GitHub, plugin installs); "none" = leave nothing out; or your own list,
# separated by commas.
TOOLS_DENY=

# ---- inference budget (optional; enforced by the modelproxy service) -----------
# The model proxy counts the prompt and completion tokens of every model call
# (per UTC day and in total; the counters are kept in the data volume). Hard
# caps: once one is reached, further model calls are refused and the bot says
# that its allowance is used up. Empty or 0 = no limit. A cap is checked before each
# call, so the last call can overshoot it by its own size.
BUDGET_TOKENS_PER_DAY=
BUDGET_TOKENS_TOTAL=
# Caps in US dollars need prices: USD per million input and output tokens, per
# model id, as JSON on one line; "*" is the price for any model not listed.
# A third number is the price of cached input tokens (providers that cache the
# repeated start of a prompt bill those at a fraction of the input price);
# without it cached tokens are billed at the full input price.
#   BUDGET_PRICES={"moonshotai/Kimi-K2.6-TEE":[0.6,2.5,0.06],"*":[1,3]}
BUDGET_PRICES=
BUDGET_USD_PER_DAY=
BUDGET_USD_TOTAL=
# At most this many model calls per minute (an agent turn makes several).
BUDGET_REQUESTS_PER_MINUTE=
# How a call is answered once a cap is reached: 400 (default), 429, 402 or
# 200. Leave it empty unless you have read docs/MODELPROXY.md: 429 and 402
# make OpenClaw switch the model off for ten minutes.
MODELPROXY_EXHAUSTED_REPLY=

# ---- Telegram (optional) -----------------------------------------------------
# Paste a token from @BotFather and restart (docker compose up -d). Long polling,
# outbound only. Without TELEGRAM_ALLOWED_USER_IDS, the first DM gets a pairing
# code: approve it in the web UI (Settings > Channels > DM access requests).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ---- name, look and first conversation (optional) ------------------------------
# The bot's name and emoji in the web chat, and the accent colour of the web
# page (#rrggbb). Name and emoji are defaults: change them
# later in the web UI (Agents) and your change is kept.
BOT_DISPLAY_NAME=
BOT_EMOJI=
UI_ACCENT_COLOR=
# 1 = at start, put starter files into the agent's workspace where they are
# missing (a file that exists is never overwritten):
#   IDENTITY.md   the name and emoji above (and SOUL.md, USER.md: a few lines)
#   AGENTS.md     house rules: ask before sending to others, posting, buying
#                 or deleting; never handle wallet secrets; spend few model calls
#   BOOTSTRAP.md  the first conversation (only in a brand-new data directory):
#                 the bot says who it is, that it will never ask for a seed
#                 phrase or private key, and offers four Bittensor jobs
# The templates are in bot/seed/. Keep them short if you change them: OpenClaw
# sends these files to the model with every request.
SEED_WORKSPACE=
# The owner's PUBLIC Bittensor address (SS58), written into those files so the
# bot can report on it without asking. Public data, not a secret.
OWNER_WALLET_SS58=

# ---- backups (optional; nothing runs on a timer) ---------------------------------
# An age PUBLIC key (age1...). bot/backup.sh encrypts every backup to it before
# it leaves the bot; the private key is never given to the bot. README, "Back
# up and restore".
BACKUP_AGE_RECIPIENT=
# Seconds allowed for the upload of a backup / the download of one (default 900).
# BACKUP_UPLOAD_TIMEOUT=900
# BACKUP_DOWNLOAD_TIMEOUT=900

# ---- behaviour / sizing --------------------------------------------------------
# full = agent runs shell commands without asking (default, demo);
# ask  = allowlist + ask the owner for anything else (approvals in the web UI).
EXEC_MODE=full
BOT_NAME=fugal-bot
BOT_MEM_LIMIT=2560m
BOT_CPUS=2.0
DESKTOP_GEOMETRY=1280x800
TZ=UTC
# Internal Docker networks (first three octets of two /28 ranges). Change only
# if they clash with another network on the host, or to run two bots side by side.
FRONT_NET=10.213.57
TUNNEL_NET=10.213.58
# Rarely needed. The Origin the proxy puts on verified same-origin browser
# requests (the proxy and the bot must agree on it; it is never resolved).
# CONTROL_UI_ORIGIN=https://bot.invalid
# false = switch off the bot's OpenAI-compatible HTTP API (/v1/chat/completions
# behind the login); the web chat does not need it.
# ENABLE_OPENAI_API=true
# false = do not ask the model endpoint for token usage on streamed replies
# (only for an endpoint that rejects the request field; tokens are then estimated).
# MODELPROXY_STREAM_USAGE=true

# ---- where the data lives, which files compose reads (optional) -----------------
# By default all data is in one Docker volume and compose reads compose.yaml.
# To keep the data in a host directory instead (it must exist), and on hosts
# where containers get no NAT (docs/CATHEDRAL.md):
# DATA_DIR=/workspace/fugal-bot-data
# COMPOSE_FILE=compose.yaml:compose.datadir.yaml          # data in DATA_DIR
# COMPOSE_FILE=compose.yaml:compose.cathedral.yaml        # ... and every service on the host network
# COMPOSE_PROFILES=tunnel                                 # a public URL through a Cloudflare quick tunnel

# ---- login page (optional; shown only when set) --------------------------------
# e.g. HOST_LABEL=Cathedral confidential sandbox (Bittensor subnet 94)
HOST_LABEL=
# e.g. MODEL_LABEL=Kimi K2.6 on Chutes (TEE). Nothing about the model is shown unless set.
MODEL_LABEL=
# e.g. a link to the source code
REPO_URL=

# ==== hosted mode (only for a bot run FOR its owner by a site; leave empty otherwise) ====
# For a site that runs many bots, one per owner, each in its own room, and
# shows them in a frame on its own page (docs/CATHEDRAL.md, "Hosted mode" and
# "Controller contract"). A bot you run for yourself needs none of this.
#
# GATE_SSO=on replaces the password login by a one-time token that the site
# posts into the frame; the password form is then switched off, and
# ACCESS_PASSWORD (32+ random characters, never typed by anyone) is only the
# secret the tokens are signed with. SESSION_HOURS is how long a sign-in lasts.
GATE_SSO=
# This bot's id ("b" and 10 characters of a-z, 2-7); tokens for other bots are refused.
GATE_BOT_ID=
# The page that shows the bot. A browser that opens the bot directly, without
# a session, is sent there.
GATE_LOGIN_URL=
# The one origin that may show the bot in a frame and post the token. Empty =
# the origin of GATE_LOGIN_URL.
GATE_PARENT_ORIGIN=
# Token of the Cloudflare named tunnel that gives this bot its hostname. Given
# only to the tunnel service, as an environment variable.
TUNNEL_TOKEN=
# Where the restore one-shot finds the age identity (the PRIVATE key) on the
# host, for the one run that needs it. Must be readable by uid 1000.
# RESTORE_IDENTITY_FILE=/work/restore/identity.txt
#
# A hosted bot's whole .env, with the variables from the sections above. The
# site's controller writes one such file per bot; nothing else is needed next
# to the compose files (the images are pulled, never built).
#
#   # layout
#   COMPOSE_FILE=compose.yaml:compose.cathedral.yaml:compose.hosted.yaml
#   COMPOSE_PROFILES=hosted
#   DATA_DIR=/workspace/fugal-bot-data
#   BIND_ADDRESS=127.0.0.1
#   PORT=8080
#   PUBLIC_HOSTNAME=                     (stays empty: TLS ends at Cloudflare)
#   BOT_IMAGE=...  MODELPROXY_IMAGE=...  GATE_IMAGE=...  PROXY_IMAGE=...   (the four lines of images.env)
#   BOT_MEM_LIMIT=4g
#   TZ=UTC
#   # access
#   ACCESS_PASSWORD=<32+ random characters>
#   GATE_SSO=on
#   GATE_BOT_ID=<b + 10 characters>
#   GATE_LOGIN_URL=https://site.example/bot
#   GATE_PARENT_ORIGIN=                  (empty: the origin of GATE_LOGIN_URL)
#   SESSION_HOURS=24
#   # model (the key is the site's per-bot token for its gateway, or the owner's own key)
#   MODEL_BASE_URL=https://site.example/bot-llm/v1
#   MODEL_API_KEY=<token>
#   MODEL_NAME=<model id>
#   MODEL_CONTEXT_WINDOW=64000
#   MODEL_MAX_TOKENS=4096
#   MODEL_REASONING=false
#   MODEL_SUPPORTS_TOOLS=true
#   MODEL_INPUT=text
#   MODEL_EXTRA_BODY=                    (JSON on one line, not quoted)
#   # identity and behaviour
#   BOT_DISPLAY_NAME=<name>              (not quoted, spaces allowed)
#   BOT_EMOJI=<one emoji>
#   UI_ACCENT_COLOR=#2f6fed
#   SEED_WORKSPACE=1
#   OWNER_WALLET_SS58=<the owner's public address>
#   BACKGROUND_MODEL_USE=off
#   TOOLS_DENY=
#   EXEC_MODE=full
#   # plumbing
#   TELEGRAM_BOT_TOKEN=
#   TELEGRAM_ALLOWED_USER_IDS=
#   TUNNEL_TOKEN=<token of this bot's named tunnel>
#   BACKUP_AGE_RECIPIENT=age1...         (the public key; given to the bot and to the backup one-shot)
#
# scripts/hosted-test.sh starts a bot from exactly such a file.

# ---- published images (optional) -------------------------------------------------
# The "images" workflow of this repository publishes four images to
# ghcr.io/fugal-ai (fugal-bot, fugal-bot-modelproxy, fugal-bot-gate,
# fugal-bot-proxy), tagged with the commit and, for a release, its tag. Point
# these at them, pinned by digest, to skip building. The four lines, with
# digests, are in the summary of each workflow run and in images.env inside
# fugal-bot-room-<version>.tgz (a file of the release, and of the run). Then:
#   docker compose pull && docker compose up -d --no-build
# The published proxy is the no-file-capability build (proxy/Dockerfile.nocap),
# which works everywhere, Cathedral rooms included.
#   BOT_IMAGE=ghcr.io/fugal-ai/fugal-bot@sha256:...
BOT_IMAGE=
MODELPROXY_IMAGE=
GATE_IMAGE=
PROXY_IMAGE=
